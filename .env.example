# API Server Configuration
API_URL=http://127.0.0.1:8000/api/v1
PORT=8000
DEBUG=False

# Primary LLM: NVIDIA NIM (Nemotron-3-nano / Llama-3.1-nemotron)
NVIDIA_API_KEY=your_nvidia_api_key_here
LLM_MODEL=nvidia/nemotron-3-nano
LLM_TEMPERATURE=0.2

# Fallback LLM Providers (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Relational Database: Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your_supabase_anon_or_service_key
SUPABASE_DB_NAME=task_manager

# Vector Database: ChromaDB
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_COLLECTION_NAME=task_embeddings

# Scheduler & Reminders
SCHEDULER_ENABLED=True
REMINDER_CHECK_INTERVAL_MINUTES=5
LOG_LEVEL=INFO
